# Non-secret runtime configuration — COMMITTED ON PURPOSE.
#
# This file survives sandbox resets (it ships with git), unlike .env which is
# gitignored and gets wiped on every workspace rebuild. Only NON-secret values
# may live here; every credential stays in the gitignored .env:
#   SMTP_USER / SMTP_PASS (Gmail app password), DISCORD_CLIENT_ID /
#   DISCORD_CLIENT_SECRET, DB_MIRROR_EXPORT_KEY, DATABASE_URL.
#
# WHY DISCORD_* IS PINNED: the deployed server sits behind a platform gateway
# that can present the request as an internal Alibaba FC host (e.g.
# http://liner-mc-*.cn-hongkong-vpc.fcapp.run). Deriving the OAuth redirect
# from the incoming request host produced redirect_uri values Discord rejects
# (host not registered in the portal + plain http). Pinning the public base
# and the redirect URI makes the flow host-independent.

# --- Discord OAuth2 (public values; the SECRET lives in .env) ---------------
DISCORD_PUBLIC_BASE=https://liner-music.space-z.ai
DISCORD_REDIRECT_URI=https://liner-music.space-z.ai/api/auth/discord/callback

# --- Mail identity (no secrets) ---------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=Liner System <linersystem22@gmail.com>
# Banner/button URLs inside the mail HTML must point at the real site —
# the template default (tryliner.fun) is the upstream Liner service.
MAIL_PUBLIC_BASE_URL=https://liner-music.space-z.ai
