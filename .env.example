# Website (Next.js) runtime env — Next traces this file into the standalone
# build output, so it reaches the deployed server. Copy to .env and fill in.
# .env is gitignored: never commit real secrets.

# SQLite database location (in production the platform injects its own
# DATABASE_URL, which takes precedence over this file).
DATABASE_URL="file:./db/custom.db"

# Mail (welcome / ban notice emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Discord OAuth2 sign-in (https://discord.com/developers/applications)
# 1. Create an application and copy its Client ID / Client Secret here.
# 2. In OAuth2 -> Redirects add, for every host the site runs on:
#      https://<your-host>/api/auth/discord/callback
# 3. Scopes used by the app: identify email (set automatically).
# The flow is Authorization Code + PKCE S256, so it works whether the
# application is marked public or confidential in the portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional overrides (defaults are the real Discord endpoints; the redirect
# URI is derived from the incoming request host unless overridden):
# DISCORD_REDIRECT_URI=https://liner-music.space-z.ai/api/auth/discord/callback
# DISCORD_PUBLIC_BASE=https://liner-music.space-z.ai
# DISCORD_API_BASE=https://discord.com/api
# DISCORD_AUTHORIZE_BASE=https://discord.com/oauth2/authorize
